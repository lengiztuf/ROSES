<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Beautiful Rose 🌹</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: linear-gradient(to bottom, #180b20, #40152e);
            font-family: Georgia, serif;
            overflow: hidden;
        }

        h1 {
            color: #ffb6c1;
            text-shadow: 0 0 15px #ff1744;
            animation: glow 2s infinite alternate;
        }

        .rose {
            position: relative;
            width: 200px;
            height: 300px;
            animation: sway 3s ease-in-out infinite;
            transform-origin: bottom center;
        }

        .petal {
            position: absolute;
            width: 70px;
            height: 90px;
            background: linear-gradient(135deg, #ff1744, #9b0035);
            border-radius: 50% 50% 45% 45%;
            top: 35px;
            left: 65px;
            box-shadow: 0 0 15px #ff174466;
        }

        .petal:nth-child(1) {
            transform: rotate(-45deg) translateY(-15px);
        }

        .petal:nth-child(2) {
            transform: rotate(45deg) translateY(-15px);
        }

        .petal:nth-child(3) {
            transform: rotate(-90deg) translateY(-12px);
        }

        .petal:nth-child(4) {
            transform: rotate(90deg) translateY(-12px);
        }

        .petal:nth-child(5) {
            transform: scale(0.75);
            background: #ff4569;
        }

        .stem {
            position: absolute;
            width: 8px;
            height: 180px;
            background: linear-gradient(to right, #14532d, #4caf50);
            left: 96px;
            top: 105px;
            border-radius: 10px;
            z-index: -1;
        }

        .leaf {
            position: absolute;
            width: 55px;
            height: 28px;
            background: linear-gradient(135deg, #4caf50, #14532d);
            border-radius: 100% 0 100% 0;
        }

        .leaf.left {
            top: 180px;
            left: 42px;
            transform: rotate(15deg);
        }

        .leaf.right {
            top: 225px;
            left: 100px;
            transform: rotate(75deg);
        }

        .message {
            color: #ffd6e0;
            font-size: 20px;
            text-align: center;
            margin-top: 5px;
        }

        button {
            margin-top: 20px;
            padding: 12px 25px;
            border: none;
            border-radius: 25px;
            background: #ff4569;
            color: white;
            font-size: 16px;
            cursor: pointer;
            box-shadow: 0 0 15px #ff456988;
        }

        button:hover {

            background: #ff1744;
            transform: scale(1.05);
        }

        @keyframes sway {
            0%, 100% { transform: rotate(-5deg); }
            50% { transform: rotate(5deg); }
        }

        @keyframes glow {
            from { text-shadow: 0 0 5px #ff1744; }
            to { text-shadow: 0 0 25px #ff1744; }
        }
    </style>
</head>

<body>

    <h1>🌹 A Rose for You 🌹</h1>

    <div class="rose">
        <div class="petal"></div>
        <div class="petal"></div>
        <div class="petal"></div>
        <div class="petal"></div>
        <div class="petal"></div>

        <div class="stem"></div>
        <div class="leaf left"></div>
        <div class="leaf right"></div>
    </div>

    <p class="message" id="message">
        Every rose has a story. ❤️
    </p>

    <button onclick="changeMessage()">
        Click for a Surprise 💌
    </button>

    <script>
        const messages = [
            "You make the world more beautiful. 🌹",
            "Sending you a little happiness. ❤️",
            "May your days bloom like roses. 🌸",
            "Keep growing and shining! ✨",
            "You deserve all the beautiful things in life. 💖"
        ];

        let index = 0;

        function changeMessage() {
            document.getElementById("message").textContent =
                messages[index];

            index = (index + 1) % messages.length;
        }
    </script>

</body>
</html>
